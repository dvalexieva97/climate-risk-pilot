# Copy to .env and fill in values

# GCS bucket for COG uploads (uni GCP project)
CLIMATE_RISK_GCS_BUCKET=your-uni-bucket-name
CLIMATE_RISK_GCS_UPLOAD=false

# Path to ELSUS v2 GeoTIFF (after ESDAC registration)
ELSUS_RAW_PATH=data/raw/elsus/ELSUS_v2.tif

# Optional Earth Engine GCP project
# EE_PROJECT=your-gcp-project-id
